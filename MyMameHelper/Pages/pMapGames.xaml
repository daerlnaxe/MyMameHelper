<Page x:Class="MyMameHelper.Pages.pMapGames"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MyMameHelper.Pages"
      xmlns:commands ="clr-namespace:MyMameHelper.Commands"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280" d:Background="White"
      Title="pMapGames" Loaded="Page_Loaded">
    <Page.CommandBindings>
        <CommandBinding Command="commands:UICommands.AddGame" CanExecute="Can_AddGame" Executed="Ex_AddGame"/>
        <CommandBinding Command="commands:UICommands.RemoveGame" CanExecute="Can_RemoveGame" Executed="Ex_RemoveGame"/>
    </Page.CommandBindings>
    <Page.Resources>
        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Margin" Value="0"/>

        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox" >
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- Boutons -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <!-- Boutons spéciaux -->
        <Style TargetType="Button" x:Key="miniBtn">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="2" BorderThickness="1" BorderBrush="Black"
                                Background="{TemplateBinding Background}"
                                >
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!-- Content -->
    <DockPanel>
        <!-- Left -->
        <!-- StackPanel DockPanel.Dock="left">
            <Button Style="{DynamicResource miniBtn}" Content="X"/>
        </StackPanel -->
        <!-- Top -->
        <Border  DockPanel.Dock="Top" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Margin="5">
            <StackPanel>
                <!-- -->
                <Label Content="Informations:" Grid.ColumnSpan="3" FontSize="16"/>
                <StackPanel Orientation="Horizontal">

                    <!--StackPanel.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </StackPanel.RowDefinitions>
                <StackPanel.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </StackPanel.ColumnDefinitions-->
                    <!-- Compteur des jeux à updater>
                    <Label Content="Jeux à updater:" Grid.Row="2" Grid.Column="0"/>
                    <Label Content="{Binding OrpheanRoms.Count, FallbackValue='0'}" Grid.Row="2" Grid.Column="1" /-->
                    <!--#endregion-->
                    <!--#region Roms -->
                    <!-- Compteur des roms orphelines -->
                    <Label Content="Roms orphelines:"  Grid.Row="1"/>
                    <Label Content="{Binding OrpheanRoms.Count, FallbackValue='0'}"  Grid.Column="1" Grid.Row="1" />
                    <!-- Compteur des roms à updater -->
                    <Label Content="Roms à updater:" Grid.Row="1" Grid.Column="2"/>
                    <Label Content="{Binding RomsToUpdate.Count, FallbackValue='0'}" Grid.Row="1" Grid.Column="3"/>
                    <!--#endregion-->
                    <!--#region Games -->

                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Right Panel -->
        <StackPanel DockPanel.Dock="Right" Width="300" Height="600" Margin="5" VerticalAlignment="Top">
            <Border CornerRadius="5" BorderBrush="Black" BorderThickness="1"  Background="LightGray">
                <StackPanel >
                    <!-- Titre -->
                    <Label Content="Rom Mapper" HorizontalContentAlignment="Center" Grid.ColumnSpan="3"/>
                    <StackPanel Background="white">
                        <!-- Nom du Jeu selectionné -->
                        <Label Content="{Binding SelectedGame.Game_Name, FallbackValue='Jeu Sélectionné'}" HorizontalAlignment="Center" Grid.ColumnSpan="2" FontWeight="Bold"/>
                        <!-- Filter Roms -->
                        <Label Content="Filter Rom(s):" />
                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" TextChanged="FilterChanged" />
                        <!-- List Orphean Roms -->
                        <Grid MinHeight="200" Margin="5">
                            <Grid.RowDefinitions>
                                <!--RowDefinition Height="Auto"/-->
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Add a Rom -->
                            <Label Content="Map Rom(s)s:" />
                            <ListBox Grid.Row="1" Grid.RowSpan="2" MaxHeight="450"
                                 ItemsSource="{Binding FilteredOrpheanRoms, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="RomsSelectionChanged"  
                                 SelectionMode="Extended" >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding Archive_Name}" Width="70"/>
                                            <TextBlock Text="{Binding Description, StringFormat='| {0}'}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--ComboBox ItemsSource="{Binding OrpheanRoms}" Grid.Row="5" Grid.ColumnSpan="2" SelectedItem="{Binding SelectedOrpheanRom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              IsEditable="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Archive_Name}"/>
                                    <TextBlock Text="{Binding Description, StringFormat=' | {0}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox-->
                            <Button Grid.Row="2" Grid.Column="2" Content="Go" Click="AddRom_Click"  Margin="5,0"/>

                        </Grid>
                    </StackPanel>
                    <!-- Sauvegarde Roms -->
                    <Button Content="Save Rom Links"  Click="SaveRoms_Click"/>
                </StackPanel>
            </Border>


            <!-- Liste 
            <Border Margin="5" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Padding="5" >
                <StackPanel Orientation="Horizontal">
                    <Label Content="Assign a Game:" MinWidth="100"/>
                    <ComboBox ItemsSource="{Binding Games}" DisplayMemberPath="Game_Name" SelectedValuePath="ID" SelectedItem="{Binding GameSelected}" MinWidth="300"/>
                    <Button Content="OK" Click="Assign_Game"/>
                </StackPanel>
            </Border-->

        </StackPanel>
        <!-- Bottom Panel -->
        <StackPanel DockPanel.Dock="Bottom"  Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Saving All -->
            <!--Button Content="Save" ToolTip="Save Games and associed roms" Margin="5,5,0,5"/-->
        </StackPanel>
        <!-- Panneau central -->
        <StackPanel Margin="5">
            <!-- Add - We add a new game in the list -->
            <Border CornerRadius="5" BorderBrush="Black" BorderThickness="1" >
                <StackPanel Orientation="Horizontal">
                    <Label Content="Add a game:" MinWidth="100" Margin="5"/>
                    <TextBox MinWidth="300" Text="{Binding NewGame, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Add"  Command="commands:UICommands.AddGame"/>
                </StackPanel>
            </Border>
            <!-- Game Listbox -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MinHeight="350" MinWidth="200" >
                <ListBox ItemsSource="{Binding GamesMapped}" SelectedItem="{Binding SelectedGame}" >
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- On stretch le container -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <EventSetter Event="MouseEnter" Handler="ListBoxItem_MouseEnter"/>
                            <EventSetter Event="MouseLeftButtonUp"  Handler="ListBoxItem_LeftButtonUp"/>
                            <!--EventSetter Event="MouseLeave" Handler="ListBoxItem_MouseLeave"/-->
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Stretch"  Background="LightGray">
                                <StackPanel >
                                    <!-- Affichage du Game -->
                                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                                        <Button Content="x" Style="{DynamicResource miniBtn}" Command="commands:UICommands.RemoveGame" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Game_Name}" FontWeight="Bold" FontSize="14" MinWidth="300" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!--#region Liste des ROMs pour ce Game -->
                                    <ItemsControl ItemsSource="{Binding Roms}"  Background="White">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Width="500" HorizontalAlignment="Left"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="3">
                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock Text="{Binding Archive_Name}" ToolTip="{Binding Description}" Grid.Row="1" Grid.ColumnSpan="2" Padding="2"/>
                                                        <!--#region Bouton custom des Roms -->

                                                        <Button Content="x" Width="14" Height="14" FontSize="8" 
                                                            Padding="2" Margin="2" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                                            Click="RemoveRom_Click"  CommandParameter="{Binding}"  >
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                 BorderThickness="1"
                                                                CornerRadius="2">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <!--#endregion-->
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!--#endregion Liste des Roms -->
                                    <StackPanel Height="7"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

        </StackPanel>
    </DockPanel>
</Page>
